# ─────────────────────────────────────────────
# PostgreSQL — identifiants partagés (un mot de passe pour les 4 instances)
# Chaque service se connecte uniquement à SA base via DATABASE_URL
# ─────────────────────────────────────────────
POSTGRES_USER=podiq
POSTGRES_PASSWORD=change_me_in_dev

# DATABASE_URL par service — injectées automatiquement par docker-compose
# Ne pas modifier ces valeurs sauf si vous changez les ports ou noms de containers
GATEWAY_DATABASE_URL=postgresql://podiq:change_me_in_dev@postgres-gateway:5432/podiq_gateway  # pragma: allowlist secret
AUTH_DATABASE_URL=postgresql://podiq:change_me_in_dev@postgres-auth:5432/podiq_auth  # pragma: allowlist secret
ANALYZER_DATABASE_URL=postgresql://podiq:change_me_in_dev@postgres-analyzer:5432/podiq_analyzer  # pragma: allowlist secret
AI_DATABASE_URL=postgresql://podiq:change_me_in_dev@postgres-ai:5432/podiq_ai  # pragma: allowlist secret

# ─────────────────────────────────────────────
# Redis (queue Dramatiq + cache)
# Limite mémoire + allkeys-lru : voir REDIS.md et docker-compose (redis)
# ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=256mb

# ─────────────────────────────────────────────
# Auth (auth-service)
# ─────────────────────────────────────────────
JWT_SECRET=change_me_use_long_random_string
JWT_EXPIRY_MINUTES=60
API_KEY_SALT=change_me_salt

# ─────────────────────────────────────────────
# Gateway JWT (workspace-scoped tokens, signés par gateway)
# ─────────────────────────────────────────────
GATEWAY_JWT_SECRET=change_me_gateway_jwt_secret
GATEWAY_JWT_ACCESS_EXPIRY_MINUTES=60
GATEWAY_REFRESH_SECRET=change_me_gateway_refresh_secret
GATEWAY_REFRESH_EXPIRY_DAYS=30

# ─────────────────────────────────────────────
# CORS (frontend origins autorisés)
# ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# ─────────────────────────────────────────────
# Ollama (AI service)
# ─────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral

# ─────────────────────────────────────────────
# gRPC endpoints (DNS interne Docker)
# ─────────────────────────────────────────────
AUTH_GRPC_HOST=auth-service
AUTH_GRPC_PORT=50051
ANALYZER_GRPC_HOST=analyzer-service
ANALYZER_GRPC_PORT=50052
AI_GRPC_HOST=ai-service
AI_GRPC_PORT=50053

# ─────────────────────────────────────────────
# Django (commun à tous les services Django)
# ─────────────────────────────────────────────
DJANGO_SECRET_KEY=change_me_django_secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,gateway,auth-service,analyzer-service,ai-service

# ─────────────────────────────────────────────
# Limites métier
# ─────────────────────────────────────────────
MAX_LOG_LINES=2000
# CPU (Ollama cold start ~100s + inférence) : mettre 600
# GPU ou warm : 60-120 suffisent
AI_TIMEOUT_SECONDS=600
INCIDENT_HISTORY_DEPTH=5
CORRELATION_WINDOW_MINUTES=15

# ─────────────────────────────────────────────
# Observabilité
# ─────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# LOG_FORMAT=json
# LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# CI/CD (optionnel)
# ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─────────────────────────────────────────────
# SMTP (invitations + alertes email)
# ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
